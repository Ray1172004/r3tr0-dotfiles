@import "../ray-dark.rasi"

configuration {
    font: "JetBrainsMono Nerd Font 10";
    show-icons: false;
}

window {
    location: northeast;
    anchor: northeast;
    x-offset: -12px;
    y-offset: 48px;

    width: 340px;
    height: 0px;

    background-color: #11111bf2;
    border: 1px;
    border-color: #b49aff;
    border-radius: 16px;
    padding: 14px;
}

mainbox {
    background-color: transparent;
    spacing: 10px;
    children: [inputbar, listview];
}

inputbar {
    background-color: #242438;
    border-radius: 10px;
    padding: 10px;
    children: [prompt, entry];
    spacing: 8px;
}

prompt {
    background-color: transparent;
    text-color: #b49aff;
}

entry {
    background-color: transparent;
    text-color: #e7e4f4;
    placeholder: "Buscar...";
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 4;
    spacing: 6px;
    fixed-height: false;
    scrollbar: false;
}

element {
    background-color: #242438;
    text-color: #e7e4f4;
    padding: 10px;
    border-radius: 10px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 10";
}

element selected.normal {
    background-color: #382d58;
    text-color: #b49aff;
    border: 1px;
    border-color: #b49aff;
}
